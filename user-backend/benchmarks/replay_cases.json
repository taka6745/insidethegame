{
 "description": "Replay golden set over the shipped 90-minute recording. Expectations are filters over the observed prefix, so they stay exact if the recording is regenerated; player-specific cases name players from that recording.",
 "cases": [
  {
   "id": "goals-full-time",
   "prompt": "Replay the goals",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "goal"
     ]
    }
   }
  },
  {
   "id": "shots-on-goal-so-far",
   "prompt": "Show me all the shots on goal so far",
   "at": "full_time",
   "expect": {
    "filters": [
     {
      "event_types": [
       "goal"
      ]
     },
     {
      "event_types": [
       "shot"
      ],
      "outcome": "saved"
     }
    ]
   }
  },
  {
   "id": "every-shot-first-half",
   "prompt": "Show me every shot in the first half",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "shot",
      "goal"
     ],
     "period": 1
    }
   }
  },
  {
   "id": "shots-so-far-mid-first-half",
   "prompt": "Show me all the shots so far",
   "at": 1500,
   "expect": {
    "filters": {
     "event_types": [
      "shot",
      "goal"
     ]
    }
   }
  },
  {
   "id": "player-shots",
   "prompt": "Show me Reece James's shots",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "shot",
      "goal"
     ],
     "player_id": "chelsea-6"
    }
   }
  },
  {
   "id": "headers-by-player",
   "prompt": "Show me all the headers by Cole Palmer",
   "at": "full_time",
   "expect": {
    "filters": {
     "qualifiers": {
      "bodyPart": "head"
     },
     "player_id": "chelsea-1",
     "event_types": [
      "pass",
      "shot",
      "goal",
      "clearance"
     ]
    }
   }
  },
  {
   "id": "saves",
   "prompt": "Show me the saves",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "save"
     ],
     "qualifiers": {
      "defensiveBlock": false
     }
    }
   }
  },
  {
   "id": "cards",
   "prompt": "Show me the yellow cards",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "card"
     ]
    }
   }
  },
  {
   "id": "corners",
   "prompt": "Replay the corners",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "corner"
     ]
    }
   }
  },
  {
   "id": "interceptions",
   "prompt": "Show me every time a pass was intercepted",
   "at": "half_time+120",
   "expect": {
    "filters": {
     "event_types": [
      "interception"
     ]
    }
   }
  },
  {
   "id": "all-headers",
   "prompt": "Show me all the headers in the second half",
   "at": "full_time",
   "expect": {
    "filters": {
     "qualifiers": {
      "bodyPart": "head"
     },
     "period": 2,
     "event_types": [
      "pass",
      "shot",
      "goal",
      "clearance"
     ]
    }
   }
  },
  {
   "id": "absent-player",
   "prompt": "Show me all the headers by Mbappé",
   "at": "full_time",
   "expect": {
    "absent": true
   }
  },
  {
   "id": "broad-passes",
   "prompt": "Show me all the passes",
   "at": "full_time",
   "expect": {
    "filters": {
     "event_types": [
      "pass"
     ]
    },
    "list_all": false
   }
  },
  {
   "id": "first-half-summary",
   "prompt": "How did the first half go?",
   "at": "half_time+120",
   "expect": {
    "key_moments": {
     "period": 1,
     "top": 5,
     "min": 0.8
    }
   }
  },
  {
   "id": "second-half-summary",
   "prompt": "How did the second half go?",
   "at": "full_time",
   "expect": {
    "key_moments": {
     "period": 2,
     "top": 5,
     "min": 0.8
    }
   }
  },
  {
   "id": "highlights",
   "prompt": "Show me the highlights so far",
   "at": "full_time",
   "expect": {
    "key_moments": {
     "top": 6,
     "min": 0.8
    }
   }
  },
  {
   "id": "last-ten-minutes",
   "prompt": "What happened in the last 10 minutes?",
   "at": 4200,
   "expect": {
    "window_minutes": 10
