{
 "description": "Replay golden set over the shipped 90-minute recording. Expectations are filters over the observed prefix, so they stay exact if the recording is regenerated; player-specific cases name players from that recording. Since 2026-10-21 expectations are SPADL filters (action_types, results, bodyparts, zones, shot_outcomes) over ETL's converted actions, or {\"cards\": colour} for MA3 cards; evidence ids are a{actionId} or card:{id}. Cases marked \"recording\": \"archive\" (key-moment summaries) run against narrative-engine/fixtures/archive/riverton-forgeham-grf.json with the narrative fixtures bound to it; every other case runs against the shipped recording with no narratives.",
 "cases": [
  {
   "id": "goals-full-time",
   "prompt": "Replay the goals",
   "at": "full_time",
   "expect": {
    "filters": [
     {
      "action_types": [
       "shot",
       "shot_penalty",
       "shot_freekick"
      ],
      "results": [
       "success"
      ]
     },
     {
      "action_types": [
       "bad_touch"
      ],
      "results": [
       "owngoal"
      ]
     }
    ]
   }
  },
  {
   "id": "shots-on-goal-so-far",
   "prompt": "Show me all the shots on goal so far",
   "at": "full_time",
   "expect": {
    "filters": {
     "action_types": [
      "shot",
      "shot_penalty",
      "shot_freekick"
     ],
     "shot_outcomes": [
      "goal",
      "saved"
     ]
    }
   }
  },
  {
   "id": "every-shot-first-half",
   "prompt": "Show me every shot in the first half",
   "at": "full_time",
   "expect": {
    "filters": {
     "action_types": [
      "shot",
      "shot_penalty",
      "shot_freekick"
     ],
     "period": 1
    }
   }
  },
  {
