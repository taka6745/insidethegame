      "isDeleted": true,
      "boundElements": [],
      "updated": 1792286033847,
      "created": 1792286024786,
      "link": null,
      "locked": false,
      "text": "You are forming these excerpts for a specific\nuser type. A user type is comprised of a\ncombination of their team support (home,\naway, neutral) and their football experience\nlevel (simple, casual, experienced, analyst).\nTailor your excerpt as follows:",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You are forming these excerpts for a specific user type. A user type is comprised of a combination of their team support (home, away, neutral) and their football experience level (simple, casual, experienced, analyst). Tailor your excerpt as follows:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
