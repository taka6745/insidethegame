      "link": null,
      "locked": false,
      "text": "- Team support: home and away fans should\nhear the story from their team's perspective\nand share in its highs and lows. Neutral users\nshould get a balanced account.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Team support: home and away fans should hear the story from their team's perspective and share in its highs and lows. Neutral users should get a balanced account.",
