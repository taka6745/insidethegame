1 (hackathon) flow\",\"fontSize\":14,\"fontFamily\":2,\"textAlign\":\"left\",\"verticalAlign\":\"top\",\"containerId\":null,\"originalText\":\"Phase 1 (hackathon) flow\",\"autoResize\":true,\"lineHeight\":1.25},{\"id\":\"legend-line1\",\"type\":\"arrow\",\"x\":60,\"y\":2044,\"width\":70,\"height\":0,\"angle\":0,\"strokeColor\":\"#868e96\",\"backgroundColor\":\"transparent\",\"fillStyle\":\"solid\",\"strokeWidth\":2,\"strokeStyle\":\"dashed\",\"roughness\":0,\"opacity\":100,\"groupIds\":[\"legend\"],\"frameId\":null,\"index\":\"b8k\",\"roundness\":null,\"seed\":709,\"version\":2,\"versionNonce\":1515520390,\"isDeleted\":false,\"boundElements\":[],\"updated\":1792285248178,\"link\":null,\"locked\":false,\"points\":[[0,0],[70,0]],\"lastCommittedPoint\":null,\"startBinding\":null,\"endBinding\":null,\"startArrowhead\":null,\"endArrowhead\":\"arrow\",\"elbowed\":false},{\"id\":\"legend-t1\",\"type\":\"text\",\"x\":150,\"y\":2035,\"width\":382.6142578125,\"height\":17.5,\"angle\":0,\"strokeColor\":\"#495057\",\"backgroundColor\":\"transparent\",\"fillStyle\":\"solid\",\"strokeWidth\":1,\"strokeStyle\":\"solid\",\"roughness\":0,\"opacity\":100,\"groupIds\":[\"legend\"],\"frameId\":null,\"index\":\"b8l\",\"roundness\":null,\"seed\":711,\"version\":2,\"versionNonce\":1654276570,\"isDeleted\":false,\"boundElements\":[],\"updated\":1792285248178,\"link\":null,\"locked\":false,\"text\":\"Phase 2: Jev subscriptions, replay, playback-aware behaviour\",\"fontSize\":14,\"fontFamily\":2,\"textAlign\":\"left\",\"verticalAlign\":\"top\",\"containerId\":null,\"originalText\":\"Phase 2: Jev subscriptions, replay, playback-aware behaviour\",\"autoResize\":true,\"lineHeight\":1.25}],\"files\":{}}",
