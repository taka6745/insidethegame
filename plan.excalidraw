      "isDeleted": false,
      "boundElements": [],
      "updated": 1792283575328,
      "link": null,
      "locked": false,
      "text": "Design notes\n- Kickoff aligned to a wall-clock minute so tumbling windows match match minutes\n- Every event carries a wall-clock eventTime for TIMESTAMP BY\n- Late arrival tolerance sets how long MinuteClosed waits for stragglers\n- VAR overturn writes goalsDelta = -1 so cumulative sums stay correct\n- No events = no window, so no MinuteClosed at half time",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design notes\n- Kickoff aligned to a wall-clock minute so tumbling windows match match minutes\n- Every event carries a wall-clock eventTime for TIMESTAMP BY\n- Late arrival tolerance sets how long MinuteClosed waits for stragglers\n- VAR overturn writes goalsDelta = -1 so cumulative sums stay correct\n- No events = no window, so no MinuteClosed at half time",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1792283325564,
      "labelPosition": null,
      "baseFontSize": null
    },
