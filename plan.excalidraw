    {
      "id": "ACFGN3IAX_Z0x6VN71yS9",
      "type": "text",
      "x": -6956.5349750463465,
      "y": 12037.985549409383,
      "width": 800,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
