    {
      "id": "hhK5G5PdaYXyEsyHyxjsO",
      "type": "text",
      "x": -6837.817860848403,
      "y": 12937.522214741932,
      "width": 779.5077514648438,
      "height": 765,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIG",
      "roundness": null,
      "seed": 287085059,
      "version": 4,
      "versionNonce": 386778957,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792286033847,
      "created": 1792286024784,
      "link": null,
      "locked": false,
      "text": "The narrative author agent is called after\nevery major event, and 10 minutes after\nevery previous call if no new calls have been\nmade. It is the only personalised agent, and\nis called once for each user type that\ncurrently has at least one user tuning in.\nThe purpose of this agent is to use the\nconstructed context of the match so far,\nthe key event ledger, any raw events since\nthe last minute summary, the current game\nstate match statistics and the most recent\nnarrative excerpts it has created for this\nuser type, to author the next narrative\nexcerpt that will go to the user. As this is\nthe output users actually see, it uses a\nstronger model deployment than the other\nagents.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The narrative author agent is called after every major event, and 10 minutes after every previous call if no new calls have been made. It is the only personalised agent, and is called once for each user type that currently has at least one user tuning in. The purpose of this agent is to use the constructed context of the match so far, the key event ledger, any raw events since the last minute summary, the current game state match statistics and the most recent narrative excerpts it has created for this user type, to author the next narrative excerpt that will go to the user. As this is the output users actually see, it uses a stronger model deployment than the other agents.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4rMPckC2Er71NNEjtT_z5",
