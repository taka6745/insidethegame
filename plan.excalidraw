    {
      "id": "IDUETEARVK8k4oDUxf7Hv",
      "type": "text",
      "x": -3401.781925786718,
      "y": 14883.869829670924,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
