      "isDeleted": true,
      "boundElements": [],
      "updated": 1792286033847,
      "created": 1792286024787,
      "link": null,
      "locked": false,
      "text": "- Experience level: simple users need plain\nlanguage and no jargon. Casual users want\nthe main storylines. Experienced users\nappreciate tactical observations. Analyst\nusers want the statistics behind the story.",
