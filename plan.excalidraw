      "boundElements": [],
      "updated": 1792286033847,
      "created": 1792286024786,
      "link": null,
      "locked": false,
      "text": "It is important that the new narrative\nexcerpt you create flows on from the\nprevious excerpts naturally, however you\nshould not directly reference the previous\nnarrative excerpts in your output.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is important that the new narrative excerpt you create flows on from the previous excerpts naturally, however you should not directly reference the previous narrative excerpts in your output.",
