+// InsideTheGame instrumentation. Read-only, native metre/metre-per-second values.
+// Undo temporary mirrors, then rotate the right team's baseline into world space.
+void GameEnv::record_telemetry(Player* touched, int touch_type) {
+  auto match = GetGameTask()->GetMatch();
+  if (!match) return;
+  auto vec = [](std::ostream& o, Vector3 v, bool mirrored) {
+    if (mirrored) v.Mirror();
+    o << '[' << v.coords[0] << ',' << v.coords[1] << ',' << v.coords[2] << ']';
+  };
+  auto id = [](std::ostream& o, Player* p) {
+    if (!p) { o << "null"; return; }
+    o << '[' << p->GetTeamID() << ',' << p->GetStableID() << ']';
+  };
+  std::ostringstream o;
+  o << std::setprecision(9) << "{\"kind\":\"" << (touched ? "touch" : "frame")
+    << "\",\"physics_ms\":" << match->GetActualTime_ms()
+    << ",\"match_ms\":" << match->GetMatchTime_ms()
+    << ",\"phase\":" << int(match->GetMatchPhase())
+    << ",\"in_play\":" << (match->IsInPlay() ? "true" : "false")
+    << ",\"set_piece\":" << (match->IsInSetPiece() ? "true" : "false")
+    << ",\"score\":[" << match->GetScore(0) << ',' << match->GetScore(1) << ']'
+    << ",\"ball_position_m\":";
+  vec(o, match->GetBall()->Predict(0), match->isBallMirrored());
+  o << ",\"ball_velocity_mps\":";
+  vec(o, match->GetBall()->GetMovement(), match->isBallMirrored());
+  o << ",\"last_touch\":"; id(o, match->GetLastTouchPlayer());
+  if (touched) {
+    o << ",\"player\":"; id(o, touched);
+    o << ",\"touch_type\":" << touch_type
+      << ",\"function\":" << int(touched->GetCurrentFunctionType());
+    auto& command = touched->GetCurrentAnim()->originatingCommand;
+    o << ",\"requested_function\":" << int(command.desiredFunctionType)
+      << ",\"target_player\":";
+    id(o, command.useTouchInfo ? command.touchInfo.targetPlayer : nullptr);
+    o << ",\"forced_target_player\":";
+    id(o, command.useTouchInfo ? command.touchInfo.forcedTargetPlayer : nullptr);
+  } else {
+    auto info = get_info();
+    o << ",\"game_mode\":" << int(info.game_mode)
+      << ",\"owner\":[" << info.ball_owned_team << ',' << info.ball_owned_player << ']'
+      << ",\"players\":[";
+    bool first = true;
+    for (int team_id = 0; team_id < 2; ++team_id) {
+      auto team = match->GetTeam(team_id);
+      std::vector<Player*> players;
+      team->GetAllPlayers(players);
+      for (size_t index = 0; index < players.size(); ++index) {
+        auto p = players[index];
+        if (!p->CastHumanoid()) continue;
+        if (!first) o << ',';
+        first = false;
+        o << "{\"team\":" << team_id << ",\"index\":" << index
+          << ",\"id\":" << p->GetStableID() << ",\"position_m\":";
+        vec(o, p->GetPosition(), team->isMirrored() != (team_id == 1));
+        o << ",\"velocity_mps\":"; vec(o, p->GetMovement(), team->isMirrored() != (team_id == 1));
+        o << ",\"facing\":"; vec(o, p->GetDirectionVec(), team->isMirrored() != (team_id == 1));
+        o << ",\"body_facing\":"; vec(o, p->GetBodyDirectionVec(), team->isMirrored() != (team_id == 1));
+        o << ",\"active\":" << (p->IsActive() ? "true" : "false")
+          << ",\"has_card\":" << (p->HasCards() ? "true" : "false")
+          << ",\"tired_factor\":" << 1 - p->GetFatigueFactorInv()
+          << ",\"role\":" << int(p->GetFormationEntry().role)
+          << ",\"function\":" << int(p->GetCurrentFunctionType())
+          << ",\"animation_frame\":" << p->GetFrameNum()
+          << ",\"has_possession\":" << (p->HasPossession() ? "true" : "false")
+          << ",\"possession_ms\":" << p->GetPossessionDuration_ms()
+          << ",\"time_to_ball_ms\":" << p->GetTimeNeededToGetToBall_ms()
+          << ",\"last_touch_ms\":" << p->GetLastTouchTime_ms() << '}';
+      }
+    }
+    o << ']';
+  }
+  o << '}';
+  telemetry.push_back(o.str());
+}
