# Throwaway verification project beside the main itg-local stack (no real credentials).
#   docker compose -p itg-verify-x --env-file local/env.defaults --env-file local/verify.env.example \
#     -f local/compose.yaml --profile backend up -d --build --wait
# Volumes are per project; `docker compose -p itg-verify-x ... down -v` removes everything it made.
