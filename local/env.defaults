# Explicit Compose env file prevents reading an unrelated root .env.
# No real credentials. Local containers are bound to loopback.
ACCEPT_EULA=N

# Initial coding attempt plus this many repairs.
AGENT_MAX_REPAIRS=3
AGENT_PLAN_TIMEOUT_SECONDS=60
# Custom-stat questions chain several model calls (plan, code, repairs); with narratives sharing
# the local model they measured 56–212 s. Keep proxy read timeouts above this.
QUESTION_TIMEOUT_SECONDS=240
QUESTION_MAX_ACTIVE=4
