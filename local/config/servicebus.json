{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Queues": [],
        "Topics": [
          {
            "Name": "match-notifications",
            "Subscriptions": [
              {
                "Name": "narrative-live",
                "Rules": [{"Name": "etl-notifications", "Properties": {"FilterType": "Sql",
                  "SqlFilter": {"SqlExpression": "notificationType IN ('MinuteClosed', 'KeyEventDetected', 'PeriodStarted', 'PeriodEnded')"}}}]
              },
              {
                "Name": "integration",
                "Properties": {
                  "DefaultMessageTimeToLive": "PT2M",
                  "DeadLetteringOnMessageExpiration": false
                }
              }
            ]
          },
          {
            "Name": "narratives",
            "Subscriptions": [
              {
                "Name": "user-backend"
              },
              {
                "Name": "integration",
                "Properties": {
                  "DefaultMessageTimeToLive": "PT2M",
                  "DeadLetteringOnMessageExpiration": false
                }
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "Console"
    }
  }
}
