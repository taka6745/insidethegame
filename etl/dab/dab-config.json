{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.1.5/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DATABASE_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": false,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": false,
      "path": "/mcp"
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "production"
    },
    "health": {
      "enabled": true,
      "roles": [
        "anonymous"
      ],
      "cache-ttl-seconds": 5
    }
  },
  "autoentities": {},
  "entities": {
    "Match": {
      "source": {
        "object": "dbo.matches",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Match",
          "plural": "Matches"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ],
      "relationships": {
        "teams": {
          "cardinality": "many",
          "target.entity": "MatchTeam",
          "source.fields": [
            "matchId"
          ],
          "target.fields": [
            "matchId"
          ]
        },
        "players": {
          "cardinality": "many",
          "target.entity": "MatchPlayer",
          "source.fields": [
            "matchId"
          ],
          "target.fields": [
            "matchId"
          ]
        }
      }
    },
    "RawEvent": {
      "source": {
        "object": "dbo.rawEvents",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "RawEvent",
          "plural": "RawEvents"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "KeyEvent": {
      "source": {
        "object": "dbo.keyEvents",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "KeyEvent",
          "plural": "KeyEvents"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "MinuteStat": {
      "source": {
        "object": "dbo.minuteStats",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "MinuteStat",
          "plural": "MinuteStats"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "MatchStatsAsOf": {
      "source": {
        "object": "dbo.matchStatsAsOf",
        "type": "view",
        "key-fields": [
          "matchId",
          "contestantId",
          "periodId",
          "timeMin"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "MatchStatsAsOf",
          "plural": "MatchStatsAsOfs"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "MatchTeam": {
      "source": {
        "object": "dbo.matchTeams",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "MatchTeam",
          "plural": "MatchTeams"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "MatchPlayer": {
      "source": {
        "object": "dbo.matchPlayers",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "MatchPlayer",
          "plural": "MatchPlayers"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "MatchWatermark": {
      "source": {
        "object": "dbo.matchWatermarks",
        "type": "view",
        "key-fields": [
          "matchId"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "MatchWatermark",
          "plural": "MatchWatermarks"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "StatDefinition": {
      "source": {
        "object": "dbo.statDefinitions",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "StatDefinition",
          "plural": "StatDefinitions"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "CanonicalEvent": {
      "source": {
        "object": "dbo.canonicalEvents",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "CanonicalEvent",
          "plural": "CanonicalEvents"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "PossessionSample": {
      "source": {
        "object": "dbo.possessionSamples",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "PossessionSample",
          "plural": "PossessionSamples"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "SpadlAction": {
      "source": {
        "object": "dbo.spadlActions",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "SpadlAction",
          "plural": "SpadlActions"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "StatsAtSeq": {
      "source": {
        "object": "dbo.statsAtSeq",
        "type": "stored-procedure",
        "parameters": [
          {
            "name": "matchId",
            "required": true,
            "description": "Run-scoped match id"
          },
          {
            "name": "seq",
            "required": true,
            "description": "Canonical seq at or below the match watermark"
          }
        ]
      },
      "graphql": {
        "enabled": true,
        "operation": "query",
        "type": {
          "singular": "StatsAtSeq",
          "plural": "StatsAtSeqs"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "execute"
            }
          ]
        }
      ]
    },
    "TrendDefinition": {
      "source": {
        "object": "dbo.trendDefinitions",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "TrendDefinition",
          "plural": "TrendDefinitions"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "TrendMinutesAtSeq": {
      "source": {
        "object": "dbo.trendMinutesAtSeq",
        "type": "stored-procedure",
        "parameters": [
          {
            "name": "matchId",
            "required": true,
            "description": "Run-scoped match id"
          },
          {
            "name": "seq",
            "required": true,
            "description": "Canonical seq at or below the match watermark"
          }
        ]
      },
      "graphql": {
        "enabled": true,
        "operation": "query",
        "type": {
          "singular": "TrendMinutesAtSeq",
          "plural": "TrendMinutesAtSeqs"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "execute"
            }
          ]
        }
      ]
    },
    "TrendsAtSeq": {
      "source": {
        "object": "dbo.trendsAtSeq",
        "type": "stored-procedure",
        "parameters": [
          {
            "name": "matchId",
            "required": true,
            "description": "Run-scoped match id"
          },
          {
            "name": "seq",
            "required": true,
            "description": "Canonical seq at or below the match watermark"
          }
        ]
      },
      "graphql": {
        "enabled": true,
        "operation": "query",
        "type": {
          "singular": "TrendsAtSeq",
          "plural": "TrendsAtSeqs"
        }
      },
      "rest": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "execute"
            }
          ]
        }
      ]
    },
    "TrendSpellsAtSeq": {
      "source": {
        "object": "dbo.trendSpellsAtSeq",
        "type": "stored-procedure",
        "parameters": [
          {
            "name": "matchId",
            "required": true,
            "description": "Run-scoped match id"
          },
          {
            "name": "seq",
            "required": true,
            "description": "Canonical seq at or below the match watermark"
